---
layout: null
permalink: /search.json
sitemap: false
---
[
  {%- assign sorted = site.writeups | sort: "date" | reverse -%}
  {%- for w in sorted %}
  {
    "title": {{ w.title | jsonify }},
    "url": {{ w.url | relative_url | jsonify }},
    "type": "Write-up",
    "platform": {{ w.platform | jsonify }},
    "difficulty": {{ w.difficulty | jsonify }},
    "category": {{ w.category | jsonify }},
    "date": {{ w.date | date: "%b %Y" | jsonify }},
    "tags": {{ w.tags | jsonify }},
    "description": {{ w.description | strip_html | jsonify }},
    "text": {{ w.content | strip_html | normalize_whitespace | truncatewords: 400, "" | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {%- endfor %}
  {%- for p in site.data.navigation %},
  {
    "title": {{ p.title | jsonify }},
    "url": {{ p.url | relative_url | jsonify }},
    "type": "Page"
  }
  {%- endfor %}
]
